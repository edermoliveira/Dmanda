# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# banco de dados local
/data/
*.db
*.db-journal
*.sqlite
*.sqlite3

# arquivos enviados (uploads)
/uploads/
/public/uploads/

# ferramentas locais de teste e design
/.playwright-mcp/
**/.playwright-mcp/
/.taste-skill/

# Impeccable: binário do motor (por sistema, reinstalado por computador) e arquivos locais
/.claude/skills/impeccable/scripts/bin/
/.impeccable/config.local.json

# banco local de teste (descartável)
/.dados-teste/
