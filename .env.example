# Copie este arquivo para ".env.local" e preencha os valores.
# O ".env.local" nunca vai para o GitHub. Este arquivo (.env.example) vai, e deve ficar sem valores reais.

# --- Sistema ---
# Endereço onde o sistema está rodando (no computador: http://localhost:7100)
NEXT_PUBLIC_APP_URL=
# Nome mostrado no título das páginas
NEXT_PUBLIC_APP_NAME=
# Fuso horário usado nos prazos e na tela do dia (ex.: America/Sao_Paulo)
TZ=

# --- Banco de dados (onde as demandas ficam guardadas) ---
# Endereço de conexão do banco
DATABASE_URL=

# --- Acesso (usuário único: o admin) ---
# E-mail do admin, o único que pode entrar
ADMIN_EMAIL=
# Texto longo e aleatório que protege a sessão de login
AUTH_SECRET=

# --- Prazos ---
# Dias de prazo automático quando a demanda não tem prazo
DEFAULT_DEADLINE_DAYS=
# Quantos dias à frente a tela do dia mostra em "próximos dias"
UPCOMING_DAYS=
