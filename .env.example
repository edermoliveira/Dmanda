# Copie este arquivo para ".env.local" e preencha os valores.
# O ".env.local" nunca vai para o GitHub. Este arquivo (.env.example) vai, e deve ficar sem valores reais.
# Mesmas variáveis na Vercel (ambiente de Produção). Detalhes em supabase/LEIA-ME.md.

# --- Supabase (projeto Dmanda) ---
# Endereço do projeto (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
# Chave PÚBLICA (publishable). Só vale com a RLS e o login
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Acesso (usuário único: o Secretário) ---
# E-mail da conta autorizada. O servidor recusa qualquer outro (entrada por e-mail e senha ou pelo Google)
DMANDA_EMAIL_AUTORIZADO=
# Transição do login: deixe vazio enquanto o botão do Google deve aparecer. Troque por "nao" depois de provar a entrada por senha
# e de desligar o Google no painel do Supabase (vale no próximo build ou publicação)
DMANDA_LOGIN_GOOGLE=

# --- Só no servidor. NUNCA com NEXT_PUBLIC e nunca no Git ---
# Chave secreta do Supabase (começa com sb_secret_): rotina diária e o script "npm run definir:senha"
SUPABASE_SERVICE_ROLE_KEY=
# Texto aleatório de 16 caracteres ou mais; a Vercel o envia como "Authorization: Bearer" à rotina diária
CRON_SECRET=

# --- Só em desenvolvimento ---
# "teste" liga o banco local descartável (use "npm run dev:teste"). É recusado em produção
DMANDA_BANCO=
